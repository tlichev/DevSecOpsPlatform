# ─────────────────────────────────────────────────────────────────────────────
# DevSecOps Platform — environment variables template
# cp .env.example .env  →  fill in values  →  docker compose up -d
# NEVER commit the real .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── Django ────────────────────────────────────────────────────────────────────
# dev  → config.settings.dev
# prod → config.settings.prod
DJANGO_SETTINGS_MODULE=config.settings.dev

# Generate: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=django-insecure-replace-this-in-production-with-50-char-random-string

# Comma-separated (no spaces)
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# ── Device SSH password encryption (Fernet) ───────────────────────────────────
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FIELD_ENCRYPTION_KEY=

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0

# ── Grafana ───────────────────────────────────────────────────────────────────
# Internal Docker-network URL (server-side Grafana API calls)
GRAFANA_URL=http://grafana:3000
# Browser-accessible URL (used in iframe src attributes rendered to the user)
GRAFANA_BROWSER_URL=http://localhost:3000
GRAFANA_ADMIN_PASSWORD=changeme
GRAFANA_API_TOKEN=

# ── SNMP ─────────────────────────────────────────────────────────────────────
SNMP_DEFAULT_COMMUNITY=public
MGMT_NETWORK=192.168.100.0/24

# ── AlertManager ─────────────────────────────────────────────────────────────
ALERTMANAGER_URL=http://alertmanager:9093

# ── Fixture loading (set to 0 after first boot to avoid re-importing data) ────
LOAD_FIXTURES=1

# ── Production-only (uncomment when DJANGO_SETTINGS_MODULE=config.settings.prod)
# CORS_ALLOWED_ORIGINS=https://netops.yourdomain.com
# EMAIL_HOST=smtp.yourdomain.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=noreply@yourdomain.com
# EMAIL_HOST_PASSWORD=
# DEFAULT_FROM_EMAIL=noreply@yourdomain.com
