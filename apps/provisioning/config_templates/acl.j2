! ACL Configuration - generated by DevSecOps Platform
{% for acl in acls %}
ip access-list extended {{ acl.name }}
{% for rule in acl.rules %}
 {{ rule.action }} {{ rule.protocol }} {{ rule.source }} {{ rule.destination }}{% if rule.port is defined %} eq {{ rule.port }}{% endif %}

{% endfor %}
 deny ip any any log
!
{% endfor %}
{% for acl in acls %}
{% if acl.apply_to is defined %}
interface {{ acl.apply_to.interface }}
 ip access-group {{ acl.name }} {{ acl.apply_to.direction }}
!
{% endif %}
{% endfor %}
