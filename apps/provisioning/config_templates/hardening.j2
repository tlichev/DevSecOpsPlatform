! Security Hardening Baseline - generated by DevSecOps Platform
! Disable unnecessary services
no service finger
no service udp-small-servers
no service tcp-small-servers
no ip http server
no ip http secure-server
no cdp run
no ip source-route
no ip proxy-arp
!
! SSH v2 only
ip ssh version 2
ip ssh time-out 60
ip ssh authentication-retries 3
crypto key generate rsa modulus 2048
!
! Disable Telnet on all VTY lines
line vty 0 4
 transport input ssh
 login local
 exec-timeout 10 0
 logging synchronous
!
line con 0
 exec-timeout 10 0
 logging synchronous
!
! SNMP v3
{% if snmp_v3_user is defined %}
snmp-server group {{ snmp_v3_user.group }} v3 priv
snmp-server user {{ snmp_v3_user.username }} {{ snmp_v3_user.group }} v3 auth sha {{ snmp_v3_user.auth_password }} priv aes 128 {{ snmp_v3_user.priv_password }}
{% endif %}
snmp-server location {{ snmp_location | default("DataCenter") }}
snmp-server contact {{ snmp_contact | default("noc@company.local") }}
no snmp-server community public RO
no snmp-server community private RW
!
! Management ACL
ip access-list standard MGMT_ACCESS
{% for subnet in mgmt_subnets | default(["192.168.100.0 0.0.0.255"]) %}
 permit {{ subnet }}
{% endfor %}
 deny any log
!
line vty 0 4
 access-class MGMT_ACCESS in
!
! Logging
logging buffered 16384
logging console critical
service timestamps log datetime msec localtime show-timezone
service timestamps debug datetime msec localtime
!
! NTP
{% if ntp_server is defined %}
ntp server {{ ntp_server }}
ntp authenticate
{% endif %}
!
! Password policy
service password-encryption
security passwords min-length 10
!
! Banner
banner motd ^
==========================================================================
  AUTHORIZED ACCESS ONLY - This system is monitored and all activity is
  logged. Unauthorized access is prohibited and subject to prosecution.
==========================================================================
^
!
