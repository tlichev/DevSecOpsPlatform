! OSPF Routing Configuration - generated by DevSecOps Platform
router ospf {{ process_id | default(1) }}
 router-id {{ router_id }}
{% for network in networks %}
 network {{ network.ip }} {{ network.wildcard }} area {{ network.area }}
{% endfor %}
{% if passive_interfaces is defined %}
{% for intf in passive_interfaces %}
 passive-interface {{ intf }}
{% endfor %}
{% endif %}
 auto-cost reference-bandwidth 10000
 log-adjacency-changes
!
